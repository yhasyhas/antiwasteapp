# Copier en .env et remplir (voir README.md). Ne jamais commiter .env.
EXPO_PUBLIC_SUPABASE_URL=https://<ref-du-projet>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Facultatif : DSN du projet Sentry (public). Sans DSN, Sentry reste inactif.
EXPO_PUBLIC_SENTRY_DSN=
# Facultatif : page d'invitation (Cloudflare Pages). Sans elle, le partage ne contient que le code.
EXPO_PUBLIC_INVITE_URL=https://antigaspi-invite.pages.dev
# Facultatif : clé de site Cloudflare Turnstile (publique). Sans elle, ni captcha ni essai sans compte.
EXPO_PUBLIC_TURNSTILE_SITE_KEY=
