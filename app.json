{
  "expo": {
    "name": "bolt-expo-nativewind",
    "slug": "bolt-expo-nativewind",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "L'appareil photo sert à scanner tes aliments et leurs codes-barres."
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-localization",
      [
        "@sentry/react-native",
        {
          "url": "https://de.sentry.io/",
          "organization": "yhasral",
          "project": "react-native"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "defaultChannel": "expiry"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d7caa334-8dea-4e41-84bd-1eecdfc71e1a"
      }
    },
    "owner": "yhasyhas",
    "android": {
      "permissions": [
        "android.permission.CAMERA"
      ]
    }
  }
}
